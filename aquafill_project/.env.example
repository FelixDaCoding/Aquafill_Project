# ==============================================================================
# AquaFill Environment Configuration
# ==============================================================================

# Django Security
SECRET_KEY=django-insecure-aquafill-prelim-exam-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=*

# ==============================================================================
# Supabase PostgreSQL Database Connection
# ==============================================================================
# Once you create your free Supabase project, copy your URI connection string
# from Project Settings -> Database -> Connection string -> URI
# Example:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# NOTE: If DATABASE_URL is left empty, AquaFill will automatically use SQLite (db.sqlite3)
DATABASE_URL=
